  "id": "s3_1qzfy4g",
  "texto": "Muito bem! JACARÉ se parte em três pedaços.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "s3_e2ygk3",
  "texto": "Muito bem! CENOURA se parte em três pedaços.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "s3_f2hdzk",
  "texto": "Muito bem! ABACAXI se parte em quatro pedaços.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "s3_ewe6rz",
  "texto": "Muito bem! BORBOLETA se parte em quatro pedaços.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "s3_kv5stk",
  "texto": "Muito bem! CADEADO se parte em quatro pedaços.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "s3_1fvsouy",
  "texto": "Muito bem! TATU se parte em duas pedaços.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "s3_59xyh4",
  "texto": "Muito bem! GIRAFA se parte em três pedaços.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "s3_1427zbv",
  "texto": "Muito bem! CACHORRO se parte em três pedaços.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "s3_ffknkj",
  "texto": "Isso! PÃO tem uma sílaba, então é monossílaba.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "s3_5s72f6",
  "texto": "Isso! BONÉ tem duas sílabas, então é dissílaba.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "s3_1u1mt5w",
  "texto": "Isso! JACARÉ tem três sílabas, então é trissílaba.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "s3_r8dje5",
  "texto": "Isso! ABACAXI tem quatro sílabas ou mais, então é polissílaba.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "s3_qfidy7",
  "texto": "Isso! SOL tem uma sílaba, então é monossílaba.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "s3_yk1x1x",
  "texto": "Isso! GATO tem duas sílabas, então é dissílaba.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "s3_1o71kon",
  "texto": "Isso! CENOURA tem três sílabas, então é trissílaba.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "s3_bnhaky",
  "texto": "Isso! BORBOLETA tem quatro sílabas ou mais, então é polissílaba.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "s3_1toi5e8",
  "texto": "Bicho de 2 sílabas que mia.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "s3_tq1gi",
  "texto": "Bicho de 2 sílabas que dorme no inverno.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "s3_8in03i",
  "texto": "Legume de 3 sílabas, laranja.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "s3_frepf2",
  "texto": "Objeto de 3 sílabas onde a gente escreve.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "s3_1ypg96c",
  "texto": "Fruta de 4 sílabas, com coroa.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "s3_xpuivy",
  "texto": "Escreva uma palavra de 1 sílaba.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "s3_vprepa",
  "texto": "Escreva uma palavra de 2 sílabas.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "s3_y5v6j3",
  "texto": "Escreva uma palavra de 3 sílabas.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "s3_3rxfo",
  "texto": "Escreva uma palavra de 4 sílabas ou mais.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "s3_pnq75b",
  "texto": "Diga a palavra batendo palma e conte as palmas. O número das palmas é o da gaveta.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "s3_9au7xl",
  "texto": "Comece pelo pedaço com que a palavra COMEÇA. Ouça-a de novo e repare no primeiro som.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "s3_eus4qp",
  "texto": "Toque no alto-falante de novo e repita a palavra junto, batendo palma.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "s3_y71kvc",
  "texto": "Diga a palavra devagar e bata palma. Cada vez que a boca abre é uma bolinha — nem mais, nem menos.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "s3_clflej",
  "texto": "Essa canetinha não é a dessa palavra. Conte as sílabas dela e veja de que cor é a gaveta do número que deu.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "s3_1pxbqjq",
  "texto": "Bata palma em cada palavra do passo. Só uma delas tem três palmas.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "s3_15gk2le",
  "texto": "Confira uma por uma, batendo palma. Deixe marcada só a que der duas palmas.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "s3_1iumz3t",
  "texto": "Bata palma em cada palavra do quadro. Marque só as que passarem de três palmas.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "s3_1up07a7",
  "texto": "Não conte as letras: conte as vezes que a boca abre. Diga a palavra bem devagar.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "s3_1i78zcb",
  "texto": "Procure a casa com o primeiro pedaço da palavra e siga a linha até o último.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "s3_ddab83",
  "texto": "Leia a pista de novo: ela diz quantas sílabas a palavra tem, e isso já elimina quase todas.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "s3_1m7y7r5",
  "texto": "Diga o nome da figura em voz alta e escreva um pedaço de cada vez.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "s3_ry8ztk",
  "texto": "Bata palma na palavra que você escreveu e conte. Se o número não bater, escolha outra do banco ali embaixo.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "s3_1p8kuo3",
  "texto": "Leia a linha outra vez: ela diz quantas sílabas o exemplo precisa ter.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "s3_1c66kqm",
  "texto": "Diga a palavra devagar. O corte fica onde a sua voz faz uma pausa e recomeça.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "s3_1d06ccm",
  "texto": "Conte as sílabas da palavra primeiro. Só depois procure o nome que combina com esse número.",

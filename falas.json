 },
 {
  "id": "s3_by2zvd",
  "texto": "Antes de pintar, pegue uma canetinha ali em cima.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "s3_ci30ed",
  "texto": "O TATU SAIU DA TOCA. ELE VIU UMA BORBOLETA NA FLOR.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "s3_18e6j4e",
  "texto": "NA BIBLIOTECA DA ESCOLA HÁ UM CARTAZ GRANDE. A PROFESSORA CONTOU QUE A BORBOLETA NASCE DENTRO DE UM CASULO.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "s3_n8rfh9",
  "texto": "Primeiro toque numa figura ali embaixo. Depois toque na gaveta dela.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "s3_qqiw6i",
  "texto": "Primeiro toque numa palavra ali embaixo. Depois toque na gaveta dela.",
  "voz": "pt-BR-AntonioNeural"
 },
 {

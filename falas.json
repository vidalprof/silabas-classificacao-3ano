 },
 {
  "id": "s3_f0cmai",
  "texto": "Aprendendo a classificar as palavras pelo número de sílabas. Trinta e cinco folhas para descobrir se uma palavra é monossílaba, dissílaba, trissílaba ou polissílaba. Escreva o seu nome ali embaixo e toque em Começar.",
  "voz": "pt-BR-AntonioNeural"
 },
 {
  "id": "s3_365x",
  "texto": "Monossílaba: palavra de uma sílaba só. Por exemplo, PÃO.",
